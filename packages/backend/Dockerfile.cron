# Dockerfile para Serviço de Cron em Produção
FROM node:18-slim AS builder

WORKDIR /app

# Copiar package files
COPY package*.json ./
COPY tsconfig.json ./
RUN npm install && npm cache clean --force

# Copiar source code
COPY src ./src

# Build da aplicação (instalar TS global para garantir versao 5.x compativel)
RUN npm install -g typescript && \
    tsc && \
    find src -name "*.js" -exec sh -c 'mkdir -p dist/$(dirname ${1#src/}) && cp "$1" dist/${1#src/}' _ {} \;

# Imagem final
FROM node:18-slim AS production

# Instalar cron e dependências Oracle
RUN apt-get update && apt-get install -y --no-install-recommends \
    cron \
    libaio1 \
    curl \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/oracle \
    && cd /opt/oracle \
    && curl -o instantclient.zip https://download.oracle.com/otn_software/linux/instantclient/2340000/instantclient-basiclite-linux.x64-23.4.0.24.05.zip \
    && unzip instantclient.zip \
    && rm instantclient.zip \
    && echo /opt/oracle/instantclient_23_4 > /etc/ld.so.conf.d/oracle-instantclient.conf \
    && ldconfig

# Oracle environment
ENV LD_LIBRARY_PATH=/opt/oracle/instantclient_23_4:$LD_LIBRARY_PATH
ENV ORACLE_HOME=/opt/oracle/instantclient_23_4

WORKDIR /app

# Copiar dependências de produção
COPY package*.json ./
RUN npm install --production && npm cache clean --force

# Copiar aplicação compilada
COPY --from=builder /app/dist ./dist

# Criar arquivo de cron com tarefas unificadas (Debian cron format)
RUN echo "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" > /etc/cron.d/prevencao && \
    echo "LD_LIBRARY_PATH=/opt/oracle/instantclient_23_4" >> /etc/cron.d/prevencao && \
    echo "ORACLE_HOME=/opt/oracle/instantclient_23_4" >> /etc/cron.d/prevencao && \
    echo "" >> /etc/cron.d/prevencao && \
    echo "# Verificação diária completa às 8h (vendas + bipagens + notificações do dia anterior)" >> /etc/cron.d/prevencao && \
    echo "0 8 * * * root cd /app && npm run run:daily:verification:prod -- --runYesterday >> /var/log/cron.log 2>&1" >> /etc/cron.d/prevencao && \
    echo "" >> /etc/cron.d/prevencao && \
    echo "# Monitoramento contínuo a cada 2 minutos (dia atual, sem notificações)" >> /etc/cron.d/prevencao && \
    echo "*/2 * * * * root cd /app && node dist/commands/daily-verification.command.js >> /var/log/cron.log 2>&1" >> /etc/cron.d/prevencao && \
    echo "" >> /etc/cron.d/prevencao && \
    echo "# Monitoramento de última bipagem - alerta se não receber bipagens por mais de 1h (a cada 1h)" >> /etc/cron.d/prevencao && \
    echo "0 * * * * root cd /app && node dist/commands/check-last-bip.command.js >> /var/log/cron.log 2>&1" >> /etc/cron.d/prevencao && \
    echo "" >> /etc/cron.d/prevencao && \
    echo "# Monitoramento de emails DVR - verifica novos emails a cada 1 minuto" >> /etc/cron.d/prevencao && \
    echo "*/1 * * * * root cd /app && node dist/commands/email-monitor.command.js >> /var/log/cron.log 2>&1" >> /etc/cron.d/prevencao && \
    echo "" >> /etc/cron.d/prevencao && \
    chmod 0644 /etc/cron.d/prevencao && \
    crontab /etc/cron.d/prevencao

# Criar diretório de logs
RUN mkdir -p /var/log && touch /var/log/cron.log

# Script de inicialização que exporta env vars pro cron
RUN echo '#!/bin/bash' > /start-cron.sh && \
    echo 'printenv | grep -v "no_proxy" >> /etc/environment' >> /start-cron.sh && \
    echo 'cron -f' >> /start-cron.sh && \
    chmod +x /start-cron.sh

CMD ["/start-cron.sh"]